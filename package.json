{
  "name": "bible",
  "version": "0.1.0",
  "description": "Bible study software",
  "private": false,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:core": "pnpm --filter @bible/core run build",
    "build:desktop": "pnpm run build:core && pnpm --filter @bible/desktop run build",
    "build:web": "pnpm run build:core && pnpm --filter @bible/web run build",
    "pack:sdk": "node scripts/pack-sdk.js",
    "setup": "node scripts/init/setup.js",
    "setup:web": "node scripts/init/setup.js --apps=web",
    "init": "node scripts/init/index.js",
    "init:modules": "node scripts/init/index.js --catalog --select=starter",
    "init:modules:dev": "node scripts/init/index.js --catalog=https://modules-dev.bible.keepthyheart.com/modules/ --select=starter",
    "init:desktop": "node scripts/init/index.js --target=desktop",
    "init:electron": "install-electron",
    "init:check": "node scripts/init/checks.js",
    "verify": "node admin/scripts/verify.js",
    "test:installer": "node admin/scripts/test-installer.js",
    "dev": "pnpm --filter @bible/desktop run dev",
    "dev:web": "pnpm --filter @bible/web run dev",
    "clean": "pnpm -r --if-present run clean",
    "test": "pnpm run build:core && pnpm run test:scripts && pnpm -r --no-bail --workspace-concurrency=1 --if-present run test",
    "test:scripts": "node scripts/build-module-pack.test.js && node scripts/init/starter-pack-presets.test.js && node scripts/generate-kth-css.js --check",
    "i18n:pseudo": "node scripts/i18n-pseudo.js && node scripts/i18n-pseudo.js --rtl",
    "i18n:pseudo:rtl": "node scripts/i18n-pseudo.js --rtl",
    "check:logical-css": "node scripts/check-logical-css.js",
    "typecheck": "pnpm -r --no-bail --if-present run typecheck",
    "typecheck:e2e": "pnpm -r --no-bail --if-present run typecheck:e2e",
    "typecheck:core": "pnpm --filter @bible/core run typecheck",
    "typecheck:desktop": "pnpm --filter @bible/desktop run typecheck",
    "rebuild-sqlite": "pnpm --filter @bible/desktop run rebuild-native",
    "generate:theme-vars": "node scripts/generate-theme-vars.js",
    "check:theme-vars": "node scripts/generate-theme-vars.js --check",
    "generate:kth-css": "node scripts/generate-kth-css.js",
    "check:kth-css": "node scripts/generate-kth-css.js --check",
    "check:translations": "node scripts/check-translations.js",
    "check:docs": "node scripts/check-doc-paths.js",
    "check:i18n-source": "node scripts/find-untranslated-strings.js --summary",
    "branding:check": "node scripts/check-branding.js",
    "generate:icons": "pnpm --filter @bible/desktop run icons",
    "validate:module": "node apps/desktop/scripts/validate-module.js",
    "generate:icons:force": "node apps/desktop/scripts/generate-icons.js --force"
  },
  "keywords": [
    "bible",
    "study",
    "desktop",
    "electron"
  ],
  "author": "Peter Rankin <psrankin@outlook.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.11.1"
  },
  "packageManager": "pnpm@12.6.0"
}
