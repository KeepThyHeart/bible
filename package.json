{
  "name": "bible",
  "version": "0.1.0",
  "description": "Bible study software",
  "private": false,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w @bible/core",
    "build:desktop": "npm run build:core && npm run build -w @bible/desktop",
    "build:standalone": "npm run build -w @bible/standalone",
    "build:cli": "npm run build:core && npm run build -w @bible/cli",
    "dev": "npm run dev -w @bible/desktop",
    "dev:standalone": "npm run dev -w @bible/standalone",
    "dev:cli": "npm run dev -w @bible/cli",
    "clean": "npm run clean --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:e2e": "npm run typecheck:e2e --workspaces --if-present",
    "typecheck:core": "npm run typecheck -w @bible/core",
    "typecheck:desktop": "npm run typecheck -w @bible/desktop",
    "rebuild-sqlite": "npm run rebuild-native -w @bible/desktop",
    "init": "node scripts/init-dev-env.js",
    "init:force": "node scripts/init-dev-env.js --force",
    "init:web": "node scripts/init-dev-env.js --target=web",
    "init:desktop": "node scripts/init-dev-env.js --target=desktop",
    "generate-settings": "node scripts/generate-settings.js",
    "index-commentary": "tsx scripts/index-commentary-verses.ts",
    "index-book": "tsx scripts/index-book-verses.ts",
    "build-semantic-index": "node scripts/build-semantic-index.js",
    "build-semantic-index:force": "node scripts/build-semantic-index.js --force",
    "package-modules": "node scripts/package-modules.js",
    "generate:locale-schemas": "node scripts/generate-locale-schemas.js",
    "check:translations": "node scripts/check-translations.js",
    "check:docs": "node scripts/check-doc-paths.js",
    "check:i18n-source": "node scripts/find-untranslated-strings.js --summary",
    "check:getstate": "node scripts/check-getstate-in-components.js",
    "generate:study-cache": "node scripts/generate-study-cache.js",
    "generate:study-cache:force": "node scripts/generate-study-cache.js --force",
    "generate:theme-vars": "node scripts/generate-theme-vars.js",
    "check:theme-vars": "node scripts/generate-theme-vars.js --check",
    "branding:check": "node scripts/check-branding.js"
  },
  "keywords": [
    "bible",
    "study",
    "desktop",
    "electron"
  ],
  "author": "Peter Rankin <psrankin@outlook.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "sqlite3": "^5.1.7",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^11.10.0"
  }
}
