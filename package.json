{
  "name": "bible",
  "version": "0.1.0",
  "description": "Bible study software",
  "private": false,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w @bible/core",
    "build:desktop": "npm run build:core && npm run build -w @bible/desktop",
    "build:web": "npm run build:core && npm run build -w @bible/web",
    "pack:sdk": "node scripts/pack-sdk.js",
    "setup": "npm run build:core && npm run init:modules && npm run init:desktop && npm run rebuild-sqlite",
    "setup:web": "npm run build:core && npm run init:modules",
    "init": "node scripts/init/index.js",
    "init:modules": "node scripts/init/index.js --catalog --select=starter",
    "init:modules:dev": "node scripts/init/index.js --catalog=https://modules-dev.bible.keepthyheart.com/modules/ --select=starter",
    "init:desktop": "node scripts/init/index.js --target=desktop",
    "init:check": "node scripts/init/checks.js",
    "dev": "npm run dev -w @bible/desktop",
    "dev:web": "npm run dev -w @bible/web",
    "clean": "npm run clean --workspaces --if-present",
    "test": "npm run build:core && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:e2e": "npm run typecheck:e2e --workspaces --if-present",
    "typecheck:core": "npm run typecheck -w @bible/core",
    "typecheck:desktop": "npm run typecheck -w @bible/desktop",
    "rebuild-sqlite": "npm run rebuild-native -w @bible/desktop",
    "generate:theme-vars": "node scripts/generate-theme-vars.js",
    "check:theme-vars": "node scripts/generate-theme-vars.js --check",
    "check:translations": "node scripts/check-translations.js",
    "check:docs": "node scripts/check-doc-paths.js",
    "check:i18n-source": "node scripts/find-untranslated-strings.js --summary",
    "branding:check": "node scripts/check-branding.js",
    "generate:icons": "npm run icons -w @bible/desktop",
    "validate:module": "node apps/desktop/scripts/validate-module.js",
    "generate:icons:force": "node apps/desktop/scripts/generate-icons.js --force"
  },
  "keywords": [
    "bible",
    "study",
    "desktop",
    "electron"
  ],
  "author": "Peter Rankin <psrankin@outlook.com>",
  "license": "GPL-3.0-or-later",
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4",
    "vite": "^7.3.6",
    "express": {
      "qs": "^6.16.0"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "better-sqlite3": "^12.11.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "better-sqlite3-multiple-ciphers": true,
    "electron-winstaller": true,
    "esbuild": true,
    "keytar": true,
    "onnxruntime-node": true,
    "usearch": true,
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "protobufjs": false
  }
}
