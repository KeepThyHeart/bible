{
  "name": "@bible/desktop",
  "version": "0.1.1",
  "description": "Electron desktop application for Bible study",
  "main": "out/main/index.js",
  "scripts": {
    "rebuild-native": "npx @electron/rebuild -f",
    "fonts": "node scripts/fetch-fonts.mjs",
    "icons": "node scripts/generate-icons.js",
    "predev": "npm run fonts && npm run icons",
    "prebuild": "npm run fonts && npm run icons",
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev",
    "build": "electron-vite build",
    "postbuild": "npx @electron/rebuild -f",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "preview": "electron-vite preview",
    "stage-build-data": "node scripts/stage-build-data.js",
    "package:win": "npm run build && npm run stage-build-data && electron-builder --win --config electron-builder.curated.yml",
    "package:mac": "npm run build && npm run stage-build-data && electron-builder --mac --config electron-builder.curated.yml",
    "package:linux": "npm run build && npm run stage-build-data && electron-builder --linux --config electron-builder.curated.yml",
    "package:lean:win": "npm run build && electron-builder --win",
    "package:lean:mac": "npm run build && electron-builder --mac",
    "package:lean:linux": "npm run build && electron-builder --linux",
    "package:code-only:win": "npm run build && electron-builder --win --config electron-builder.code-only.yml",
    "package:code-only:mac": "npm run build && electron-builder --mac --config electron-builder.code-only.yml",
    "package:code-only:linux": "npm run build && electron-builder --linux --config electron-builder.code-only.yml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=e2e/playwright.config.ts --headed",
    "test:e2e:debug": "playwright test --config=e2e/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report e2e/playwright-report"
  },
  "keywords": [
    "bible",
    "study",
    "desktop",
    "electron"
  ],
  "author": "Peter Rankin <psrankin@outlook.com>",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@tiptap/extension-character-count": "^3.20.1",
    "@tiptap/extension-color": "^3.20.1",
    "@tiptap/extension-font-family": "^3.20.1",
    "@tiptap/extension-highlight": "^3.16.0",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-link": "^3.16.0",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-subscript": "^3.20.1",
    "@tiptap/extension-superscript": "^3.20.1",
    "@tiptap/extension-table": "^3.20.1",
    "@tiptap/extension-table-cell": "^3.20.1",
    "@tiptap/extension-table-header": "^3.20.1",
    "@tiptap/extension-table-row": "^3.20.1",
    "@tiptap/extension-task-item": "^3.20.1",
    "@tiptap/extension-task-list": "^3.20.1",
    "@tiptap/extension-text-align": "^3.20.1",
    "@tiptap/extension-text-style": "^3.20.1",
    "@tiptap/extension-typography": "^3.20.1",
    "@tiptap/extension-underline": "^3.16.0",
    "@tiptap/pm": "^3.16.0",
    "@tiptap/react": "^3.16.0",
    "@tiptap/starter-kit": "^3.16.0",
    "@tiptap/suggestion": "^3.20.1",
    "better-sqlite3-multiple-ciphers": "^12.2.0",
    "dockview-react": "^5.1.0",
    "docx": "^9.6.1",
    "dompurify": "^3.4.12",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.3.9",
    "intl-messageformat": "^11.2.0",
    "keytar": "^7.9.0",
    "onnxruntime-common": "^1.24.2",
    "onnxruntime-node": "^1.24.2",
    "quickjs-emscripten-core": "0.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^3.0.6",
    "tippy.js": "^6.3.7",
    "unzipper": "^0.12.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@bible/core": "*",
    "@bible/extension-testing": "*",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/unzipper": "^0.10.11",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.16.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
