[Unit]
Description=Keep Thy Heart web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kth-web
Group=kth-web
WorkingDirectory=/opt/kth-bible/apps/web
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/node dist/server/index.js
Restart=on-failure
RestartSec=5

# Hardening. The server writes only under apps/web/data (logs, the sync database and its secret).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kth-bible/apps/web/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
