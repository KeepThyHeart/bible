# nginx in front of the web server (see docs/accounts/deploy.md).
# Use with "server": { "trustProxy": 1 } in site-config.json: one proxy hop.
# Certificates are shown as certbot paths; use your own.

server {
    listen 80;
    listen [::]:80;
    server_name bible.example.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bible.example.org;

    ssl_certificate     /etc/letsencrypt/live/bible.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bible.example.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000" always;

    # The record push may be up to 8 MiB.
    client_max_body_size 9m;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Appends the connecting address: exactly one trusted hop.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
