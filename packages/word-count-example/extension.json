{
  "$schema": "https://bible-app.local/schemas/extension-manifest-v1.json",
  "id": "ext.bible-app.word-count",
  "name": "Word Count",
  "version": "1.1.0",
  "publisher": "bible-app",
  "description": "Shows a word count for the current Bible chapter in the status bar, and a Word Count app with the chapter's most frequent words.",
  "engines": {
    "bibleApp": "^0.2.1"
  },
  "main": "src/main.js",
  "permissions": [
    "bible:read",
    "ui:status-bar",
    "ui:contribute-app"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onApp:counts",
    "onCommand:ext.bible-app.word-count.open"
  ],
  "contributes": {
    "apps": [
      {
        "id": "counts",
        "title": "Word Count",
        "icon": "media/counts.svg",
        "uiEntry": "ui/app.html"
      }
    ],
    "commands": [
      {
        "id": "ext.bible-app.word-count.open",
        "title": "Word Count: Open",
        "handlerEndpoint": "openApp"
      }
    ]
  },
  "categories": ["Utilities"],
  "keywords": ["word count", "statistics", "status bar", "app"]
}
