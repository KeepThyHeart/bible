{
  "name": "@bible/sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end encrypted sync server for accounts (task 0063 design): an Express router the web server mounts at /api/sync/v1",
  "license": "GPL-3.0-or-later",
  "author": "Peter Rankin <psrankin@outlook.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "ensure-sqlite": "node -e \"try{new (require('better-sqlite3'))(':memory:').close()}catch{process.exit(1)}\" || pnpm rebuild better-sqlite3",
    "pretest": "pnpm run ensure-sqlite",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bible/core": "workspace:^",
    "express": "^4.22.2",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.3",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^12.11.1",
    "supertest": "^7.2.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
