{
  "name": "@bible/audio",
  "version": "0.1.0",
  "private": true,
  "description": "Audio Bible engine shared by the web and desktop apps: player, recorded and on-device (Piper) providers, resolver, framework-neutral store",
  "license": "GPL-3.0-or-later",
  "author": "Peter Rankin <psrankin@outlook.com>",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./piper": {
      "types": "./src/tts/piper/index.ts",
      "default": "./src/tts/piper/index.ts"
    },
    "./cacheNames": {
      "types": "./src/cacheNames.ts",
      "default": "./src/cacheNames.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@bible/core": "workspace:^",
    "@types/node": "^20.14.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
