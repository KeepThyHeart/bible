{
  "name": "@bible/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI components (React 18 API subset, runs on React and preact/compat) and the KTH CSS framework",
  "license": "GPL-3.0-or-later",
  "author": "Peter Rankin <psrankin@outlook.com>",
  "sideEffects": ["css/**/*.css"],
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./css/*": "./css/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "eslint .",
    "test": "vitest run",
    "test:react": "vitest run --project react",
    "test:preact": "vitest run --project preact",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9.39.0",
    "jsdom": "^27.4.0",
    "preact": "^10.25.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.11"
  }
}
