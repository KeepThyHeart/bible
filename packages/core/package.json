{
  "name": "@bible/core",
  "version": "0.1.0",
  "description": "Core business logic and data access layer for Bible study applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./recite": {
      "types": "./dist/recite/index.d.ts",
      "default": "./dist/recite/index.js"
    },
    "./speech": {
      "types": "./dist/speech/index.d.ts",
      "default": "./dist/speech/index.js"
    },
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ensure-sqlite": "node -e \"try{new (require('better-sqlite3'))(':memory:').close()}catch{process.exit(1)}\" || pnpm rebuild better-sqlite3",
    "pretest": "pnpm run ensure-sqlite",
    "test": "vitest run",
    "pretest:watch": "pnpm run ensure-sqlite",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm run ensure-sqlite",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "bible",
    "data",
    "sqlite"
  ],
  "author": "Peter Rankin <psrankin@outlook.com>",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^12.11.1",
    "fast-check": "^4.10.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "hash-wasm": "^4.12.0"
  }
}
