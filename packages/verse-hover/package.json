{
  "name": "@bible/verse-hover",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in script that links Bible references on any web page and shows the verse in a popup",
  "license": "GPL-3.0-or-later",
  "author": "Peter Rankin <psrankin@outlook.com>",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && vitest run && node scripts/check-size.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/check-size.mjs",
    "gen:locales": "node scripts/gen-locales.mjs",
    "build:static": "node scripts/build-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.25.12",
    "jsdom": "^27.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
