{
  "name": "@bible/speech",
  "version": "0.1.0",
  "private": true,
  "description": "On-device speech engine: Whisper STT (transformers.js), mic capture, VAD, listener, TTS and the ISpeechApi service",
  "license": "GPL-3.0-or-later",
  "author": "Peter Rankin <psrankin@outlook.com>",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./models": {
      "types": "./src/models/whisperModels.ts",
      "default": "./src/models/whisperModels.ts"
    },
    "./worker": {
      "types": "./src/engine/whisperWorker.ts",
      "default": "./src/engine/whisperWorker.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@bible/core": "workspace:^",
    "@types/node": "^20.14.0",
    "jsdom": "^27.4.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  }
}
